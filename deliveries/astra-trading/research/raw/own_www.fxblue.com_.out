\":\"Market Analysis Tools\",\"general\":\"Other\",\"trading\":\"Order Execution \u0026 Management\"},\"title\":\"MT4/MT5 Extension\"},\"toolsForDownload\":{\"items\":{\"chartQuoteTools\":{\"description\":\"Trading Simulator, Chart Quick Tools\",\"label\":\"Simulator\"},\"more\":{\"description\":\"Technical Indicators, Account Analysis, Slingshot\",\"label\":\"More\"},\"publishingApps\":{\"description\":\"MyTrader Connector EA, Publisher, EA\",\"label\":\"Publishing apps\"},\"tradeCopying\":{\"description\":\"Personal Trade Copier, Internet Trade Mirror\",\"label\":\"Trade copying\"}},\"title\":\"Tools for Download\"}},\"tools\":{\"currencyStrength\":\"Currency strength\",\"personalTradeCopier\":\"Personal Trade Copier\",\"pivotPointCalculator\":\"Pivot Point Calculator\",\"traderSentiment\":\"Trader Sentiment\"}},\"Sidebar\":{\"backButton\":\"Go back\",\"description\":\"Choose an option from the navigation menu below.\",\"title\":\"Navigation menu\"}},\"Metadata\":{\"description\":\"Choose from a selection of trusted brokers to enhance your trading experience.\",\"siteName\":\"FX Blue\"}},\"Cryptocurrency\":{\"ada\":\"ADA\",\"btc\":\"BTC\",\"eth\":\"ETH\",\"ltc\":\"LTC\",\"xrp\":\"XRP\"},\"Currency\":{\"aud\":\"AUD\",\"cad\":\"CAD\",\"chf\":\"CHF\",\"eur\":\"EUR\",\"gbp\":\"GBP\",\"jpy\":\"JPY\",\"nzd\":\"NZD\",\"usd\":\"USD\"},\"Date\":{\"today\":\"Today\",\"tomorrow\":\"Tomorrow\",\"yesterday\":\"Yesterday\"},\"DeferredEmbed\":{\"action\":\"Load {title}\",\"notice\":\"This is loaded from another domain, which receives your IP address. Nothing is requested until you load it.\"},\"Form\":{\"optional\":\"optional\"},\"Frequency\":{\"day\":\"Day\",\"month\":\"Month\",\"none\":\"None\",\"quarter\":\"Quarter\"},\"InterstitialAd\":{\"continue\":\"Continue to page\",\"description\":\"A sponsored advertisement. Dismiss it to continue reading.\",\"title\":\"Advertisement\"},\"LivePage\":{\"Metadata\":{\"description\":\"FX Blue Live is a free web-based service for analysing and publishing your MT4 and MT5 trading history, with embeddable results and simple APIs.\",\"title\":\"Analyse Your Trading Account\"}},\"LoginRequired\":{\"button\":\"Log in\",\"message\":\"Please log in to continue to this page.\",\"title\":\"Log in required\"},\"Metals\":{\"brent\":\"BRENT\",\"wti\":\"WTI\",\"xag\":\"XAG\",\"xau\":\"XAU\"},\"MigrationRequired\":{\"description\":\"Signing in again will not help — the new sign-in has to be set up once. Finish it and you will come straight back here.\",\"title\":\"Your account still needs to move\"},\"SiteIndex\":{\"description\":\"Every page on FX Blue in one place: trading tools, market data, brokers, prop firms, news and more.\",\"home\":\"Home\",\"title\":\"Site Index\"},\"StockIndices\":{\"asx200\":\"ASX200\",\"dax\":\"DAX\",\"dj30\":\"DJ30\",\"ftse100\":\"FTSE100\",\"jp225\":\"JP225\",\"sp500\":\"SP500\"},\"Table\":{\"noData\":\"No results\"},\"YoutubeEmbed\":{\"clickToLoad\":\"{title} — click to load. Loading will set cookies from YouTube.\",\"play\":\"Play {title}. Loading this video may set cookies from YouTube.\"},\"learnMore\":\"Learn More\",\"stepper\":\"Step {step} of {total}\",\"tryNow\":\"Try Now\"},\"Forms\":{\"ChangeEmail\":{\"Inputs\":{\"emailAddress\":\"Email Address\"},\"submit\":\"Change Email\"},\"Common\":{\"Buttons\":{\"close\":\"Close\",\"showPassword\":\"Show password\",\"submit\":\"Submit\"},\"Inputs\":{\"code\":\"Code\",\"confirmNewPassword\":\"Confirm New Password\",\"confirmPassword\":\"Confirm Password\",\"email\":\"Email\",\"lastName\":\"Surname\",\"name\":\"Name\",\"newPassword\":\"New Password\",\"password\":\"Password\",\"receiveNewsletter\":\"Receive Newsletter\",\"username\":\"Username\",\"usernameOrEmail\":\"Username or Email\"},\"Validation\":{\"codeLength\":\"Enter the 6-digit code from your email\",\"consentRequired\":\"You must grant consent to continue\",\"newPasswordTooShort\":\"Password must be at least 8 characters\",\"noWhitespace\":\"Must not contain whitespace characters (spaces, tabs, etc.)\",\"passwordNeedsDigit\":\"Include at least one number\",\"passwordNeedsSymbol\":\"Include at least one character that is not a letter or a number\",\"passwordRequired\":\"Password is required\",\"passwordTooLong\":\"Password must be 128 characters or fewer\",\"passwordTooShort\":\"Password must be at least 6 characters\",\"passwordsDoNotMatch\":\"Passwords do not match\",\"pinCharacters\":\"Use letters and numbers only\",\"pinRequired\":\"PIN is required\",\"pinTooLong\":\"PIN must be 20 characters or fewer\",\"usernameFormat\":\"Use only letters A–Z, digits, “-” and “_”, starting and ending with a letter or digit\",\"usernameNotEmail\":\"A username can’t be an email address. Leave it empty, or choose one without “@”.\",\"usernameRequired\":\"Username is required\",\"usernameTooLong\":\"Username must be 20 characters or fewer\",\"usernameTooShort\":\"Username must be at least 3 characters\",\"usernamesDoNotMatch\":\"Usernames do not match\"}},\"Login\":{\"Buttons\":{\"submit\":\"Login\"},\"SubAccount\":{\"body\":\"You signed in with {username}, which sits under a main account. Sign in with the main account instead.\",\"heading\":\"Sign in with your main account\",\"hintEmailLabel\":\"Its email\",\"hintIntro\":\"In case you are not sure which account that is:\",\"hintUsernameLabel\":\"Starts with\",\"retry\":\"Try the main account\"},\"forgotPassword\":\"Forgot password? \u003clink1\u003eReset password\u003c/link1\u003e\",\"invalidCredentials\":\"Wrong username or password\",\"loginSuccess\":\"Login successful\",\"register\":\"Don't have an account? \u003clink1\u003eRegister\u003c/link1\u003e\",\"title\":\"Login\"},\"Register\":{\"Buttons\":{\"submit\":\"Register\"},\"acceptTerms\":\"By clicking register, you accept our \u003clink1\u003eTerms of use\u003c/link1\u003e and \u003clink2\u003ePrivacy Policy\u003c/link2\u003e\",\"login\":\"Already have an account? \u003clink1\u003eLog in\u003c/link1\u003e\",\"marketingOptOut\":\"I don’t want to receive emails from FX Blue, such as market reports, newsletters and offers.\",\"newsletter\":\"Do you want to receive news about our project? Sign up to our newsletter.\",\"usernameHint\":\"Your public name and profile URL. Not your email. If you skip it, we’ll create one you can change later.\"},\"optional\":\"(optional)\"},\"Login\":{\"Card\":{\"Inputs\":{\"password\":\"Password\",\"passwordPlaceholder\":\"Enter your password\",\"username\":\"Username or email\",\"usernamePlaceholder\":\"jsmith or name@email.com\"},\"description\":\"Use your FX Blue username or the email you registered with.\",\"forgotPassword\":\"Forgot password?\",\"newHere\":\"New to FX Blue?\",\"register\":\"Create a free account\",\"submit\":\"Log in\",\"title\":\"Log in to FX Blue\"},\"title\":\"Login\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$Lea\"}]\n"])</script><script>self.__next_f.push([1,"eb:T41c,You trade your FX Blue demo account using our MyTrader Platform:\u003cul\u003e\u003cli\u003eWeb\u003c/li\u003e\u003cli\u003eAndroid\u003c/li\u003e\u003cli\u003eiOS\u003c/li\u003e\u003c/ul\u003e\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eThe MyTrader platform contains a huge range of tools and features to support both experienced and new traders.Check out the Tutorials section within the platform, or the videos on our website\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eOur demo accounts are powered by our own proprietary margin engine, optimised for providing demo accounts. Our margin engine makes it easy for us to provide a variety of account types, trailing stops, rules such as  maximum drawdown, and automated scheduled creation, closure, and deletion of accounts. (Our margin engine is also very  fast. Once your order arrives over the internet, our engine  will typically execute it in sub 500 microseconds - that's \u003c 0.5 milliseconds, one two-thousandth of a second.)\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eFor brokers, we can also offer trading challenges using your own margin engine such as MT4/5 or DXtrade, rather than our margin engine. Please contact \u003cemail\u003esales@fxbluelabs.com\u003c/email\u003e37:[\"$\",\"$Le8\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"Common\":\"$3d:props:messages:Common\",\"DemoAccounts\":{\"AccountActions\":{\"authRequired\":\"Please log in to manage your demo accounts.\",\"delete\":\"Delete\",\"deleteConfirmDescription\":\"Are you sure you want to permanently delete this account?\",\"deleteConfirmNo\":\"No\",\"deleteConfirmTitle\":\"Please confirm\",\"deleteConfirmYes\":\"Yes\",\"deleteError\":\"Unable to delete the account. Please try again.\",\"deleteSuccess\":\"Account deleted successfully.\",\"deleting\":\"Deleting...\",\"openPlatform\":\"Open Platform\",\"openPlatformError\":\"Unable to open the platform. Please try again.\",\"openPlatformSuccess\":\"Platform session created.\",\"openingPlatform\":\"Opening...\",\"platformUnavailable\":\"The trading platform isn't responding right now. Please try again in a few moments.\",\"popupBlocked\":\"Please allow popups to open the trading platform\",\"showResults\":\"Show results\"},\"AccountStatus\":{\"Active\":\"This account is active.\",\"Badge\":{\"Active\":\"Active\",\"Neutral\":\"Neutral\",\"Pending\":\"Pending\",\"Successful\":\"Successful\",\"Unsuccessful\":\"Unsuccessful\"},\"ChallengeActive\":\"This trading challenge is active.\",\"ChallengeFailed\":\"This trading challenge was unsuccessful.\",\"ChallengeSuccessful\":\"Congratulations! You successfully completed this trading challenge.\",\"DeletionScheduled\":\"Depending on further login and trading activity, the account is currently scheduled for deletion at {date}.\",\"PendingStartDate\":\"This account is pending. The account will become tradeable at {date}.\",\"Reason\":{\"11\":\" The account reached its scheduled termination date.\",\"12\":\" The account was terminated because of lack of new logins.\",\"13\":\" The account was terminated because of a lack of trading activity.\",\"14\":\" The account was terminated because its equity hit the minimum level.\",\"15\":\" The account was terminated because its floating loss exceeded the permitted limit.\",\"16\":\" The account was terminated because its loss % exceeded the permitted limit.\",\"17\":\" The account was terminated because it exceeded the maximum drawdown from a previous equity peak.\",\"18\":\" The account was disqualified.\",\"24\":\" The account hit the maximum permitted daily loss (a fall in your equity since the start-of-day).\",\"70\":\" The account was terminated because another account reached the equity target.\"},\"Terminated\":\"This account has been terminated.\",\"TerminatedEquityTarget\":\"The account was terminated because it reached its equity target.\"},\"Accounts\":{\"colActions\":\"Actions\",\"colDeletionDate\":\"Date of deletion\",\"colEquity\":\"Equity\",\"colMargin\":\"Margin\",\"colName\":\"Name\",\"colPerformance\":\"Performance\",\"colStatus\":\"Status\",\"colType\":\"Type\",\"collapseRow\":\"Collapse details\",\"empty\":\"You don't have any accounts yet.\",\"expandRow\":\"Expand details\",\"loadError\":\"We couldn't load your accounts right now. Please refresh the page or try again later.\",\"ptMlTooltip\":\"PT = Profit target · ML = Max loss\",\"showOld\":\"Show old accounts\",\"title\":\"Your accounts\",\"typeChallenge\":\"Challenge\",\"typeDemo\":\"Demo\"},\"ActiveChallenges\":{\"subtitle\":\"Here are a few active challenges which users have recently set up. Think you can do better? Create a challenge of your own for free!\",\"title\":\"Active Trading Challenges\"},\"Dialog\":{\"NewDemoAccount\":{\"Button\":{\"create\":\"Create\",\"dismiss\":\"Dismiss\"},\"Limited\":{\"description\":\"Limited markets, 5% margin (20:1)\",\"title\":\"Limited\"},\"Pro\":{\"description\":\"Pro spreads, 0.5% margin (200:1)\",\"title\":\"Pro\"},\"Standard\":{\"description\":\"Standard spreads, 2% margin (50:1)\",\"title\":\"Standard\"},\"Toast\":{\"error\":\"Unable to create demo account. Please try again.\",\"success\":\"Demo account created successfully.\"},\"caption\":\"Caption\",\"captionPlaceholder\":\"Enter caption\",\"startingFunds\":\"Starting Funds\",\"title\":\"New Demo Account\",\"type\":\"Type\"},\"NewTradingChallenge\":{\"Button\":{\"create\":\"Create\",\"dismiss\":\"Dismiss\"},\"Input\":{\"caption\":\"Caption\",\"captionPlaceholder\":\"Enter a name for this account\",\"dailyLossLimit\":\"Daily Loss Limit\",\"duration\":\"Duration\",\"leverage\":\"Leverage\",\"maximumLoss\":\"Maximum Loss\",\"profitTarget\":\"Profit Target\",\"startingFunds\":\"Starting Funds\"},\"Picker\":{\"clampHint\":\"Adjusted to the {min}–{max}% range.\",\"decreaseBy\":\"Decrease by {amount}%\",\"increaseBy\":\"Increase by {amount}%\",\"noDailyLossLimit\":\"No daily loss limit\",\"noProfitTarget\":\"No profit target\",\"none\":\"None\",\"presetsLabel\":\"Choose a preset value\"},\"Toast\":{\"error\":\"Unable to create trading challenge. Please try again.\",\"success\":\"Trading challenge created successfully.\"},\"disclaimer\":\"This is a free and independent simulation not connected to the actual Prop firm in any way; parameters are replicated from public information and may differ from the live challenge. Passing the simulation does not mean you will pass the challenge itself. Check how our free demo challenges work \u003chere\u003ehere\u003c/here\u003e.\",\"title\":\"New Trading Challenge\"}},\"Hero\":{\"description\":\"Simulate the rules of a prop firm challenge you're interested in, or just trade on a demo account. All for free in the MyTrader Platform, in your browser.\",\"feature1\":\"100% free\",\"feature2\":\"Match any prop firm's rules\",\"feature3\":\"Unlimited retries\",\"openDemo\":\"Demo Account\",\"startChallenge\":\"Trading challenge\",\"title\":\"Trading Challenges \u0026 Demo Accounts\"},\"HowItWorks\":{\"step1Desc\":\"Simulate any prop firm's profit target, max loss, daily limit and duration, or invent your own.\",\"step1Title\":\"Set your rules\",\"step2Desc\":\"Start in seconds in \u003clink\u003eMyTrader\u003c/link\u003e, FX Blue's trading platform. No broker account, nothing to install, just trade from your browser or phone.\",\"step2Title\":\"Trade it in MyTrader\",\"step3Desc\":\"Pass or breach the rules you set, then reset and go again as often as you like, always free.\",\"step3Title\":\"Pass or retry\",\"title\":\"How FX Blue challenges work\",\"tryNow\":\"Try now\"},\"Metadata\":{\"title\":\"Free Trading Challenge and Demo Account\"},\"Metrics\":{\"balance\":\"Balance\",\"margin\":\"Margin\",\"performance\":\"Performance\",\"pl\":\"P/L\"},\"NotABrokerage\":{\"subtitle\":\"FX Blue is not a brokerage. We do not take client deposits, and we do not offer real-money trading accounts or paid challenges. We only provide demo accounts, for practice purposes.\",\"title\":\"We are not a prop firm or brokerage\"},\"NotBrokerage\":{\"description\":\"FX Blue is not a brokerage. We do not take client deposits, and we do not offer real-money trading accounts or paid challenges. We only provide demo accounts, for practice purposes. There is no way to generate any profit with us.\",\"title\":\"We are not a prop firm or brokerage\"},\"OurTechnology\":{\"subtitle\":\"$eb\",\"title\":\"Our technology\"},\"RegularDemoAccounts\":{\"subtitle\":\"FX Blue also offers open-ended demo accounts. These have no target or limits, and are for general practice purposes. You can choose between different margin settings and spreads depending on the conditions which you want to simulate.\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eDemo accounts generally expire if they are not used. Conditions vary, but we may delete an account if you don't log into it for a week.\",\"title\":\"Regular demo Accounts\"},\"Simulate\":{\"accountSize\":\"Account size\",\"compareAll\":\"Compare all challenges\",\"disclaimer\":\"Prop-firm challenges carry risk, fees are non-refundable, and most traders don't pass. Review each firm's terms before purchasing. FX Blue is not a prop firm; we provide free simulations for practice purposes, with no fee charged and no way to generate any profit with us.\",\"entryFee\":\"Entry fee:\",\"maxDailyLoss\":\"Max daily loss\",\"maxLoss\":\"Max loss\",\"simulateFree\":\"Simulate for free\",\"subtitle\":\"Select a challenge you want to simulate, or choose your own rules, and try it on MyTrader at no cost. Your targets, your rules. Zero entry fee, zero risk.\",\"target\":\"Target\",\"title\":\"Simulate the rules of any prop firm challenge\"},\"StartYourOwn\":{\"NewDemoAccount\":{\"startNow\":\"Start Now\",\"subtitle\":\"Create an open-ended demo account, without targets.\",\"title\":\"New Demo Account\"},\"NewTradingChallenge\":{\"startNow\":\"Start Now\",\"subtitle\":\"Create a new trading challenge, with a profit target and shutdown level.\",\"title\":\"New Trading Challenge\"},\"title\":\"Start yours and beat your competitors!\",\"titleLoggedIn\":\"Start your new account now!\"},\"TradingChallengeCard\":{\"equity\":\"Equity\",\"targets\":\"Targets\"},\"TradingChallenges\":{\"subtitle\":\"FX Blue offers free trading challenges - test out your trading before you pay an entrance fee to a prop trading firm.\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eChallenge accounts have a duration, a target, and a maximum loss. There can also be a separate limit on the maximum daily loss. Challenge accounts are terminated if any of the following happens:\u003cul\u003e\u003cli\u003eYou hit the profit target\u003c/li\u003e\u003cli\u003eYou lose more than the maximum loss\u003c/li\u003e\u003cli\u003eYour equity falls in a single day by more than the daily limit (if there is one)\u003c/li\u003e\u003cli\u003eYou reach the end of the period without hitting any of the limits\u003c/li\u003e\u003cli\u003eYou don't open a new trade at least every 72 hours (excluding weekends)\u003c/li\u003e\u003c/ul\u003e\",\"title\":\"Trading challenges\"},\"Unknown\":\"unknown\",\"WhyPractise\":{\"col1Desc\":\"Start in seconds. Set up in just a few clicks.\",\"col1Title\":\"Quick start\",\"col2Desc\":\"Use just your browser, Android or iOS, wherever you are.\",\"col2Title\":\"Nothing to download\",\"col3Desc\":\"Our own margin engine fills your entries in milliseconds, with no dealing-desk delays.\",\"col3Title\":\"Instant response\",\"col4Desc\":\"Simulated, rule-based practice with no entry fee and no real-money risk.\",\"col4Title\":\"Always free\",\"title\":\"Why traders practise on FX Blue\"},\"YourActiveAccounts\":{\"title\":\"Your Active Accounts\"},\"YourOldAccounts\":{\"title\":\"Your Old Accounts\"},\"subtitle\":\"\u003cp\u003e... before you pay an entry fee to a prop trading firm, or just practise trading with an open-ended demo account from FX Blue.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eNo broker registration! And no downloads - trade from your browser or phone.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eYou can set up a trading challenge for yourself, with your choice of duration and target. The system automatically tracks your performance, and notifies you when the challenge succeeds or fails. You can follow your tick-by-tick progress on this website or in the trading platform. Try out your trading skills before paying entry fees to prop trading firms - or just practise for fun.\u003c/p\u003e\u003cp\u003eFX Blue also offers regular demo accounts. These have no fixed duration or target. You can use them for general, open-ended trading practice.\u003c/p\u003e\",\"subtitleLoggedIn\":\"Create free practice accounts with FX Blue: trading challenges, with a profit target and a shutdown level, or open-ended demo accounts, without targets. Powered by our unique Figaro web and mobile platform, connecting to our super-fast demo account margin engine.\",\"title\":\"Free Trading Challenge and Demo Account\"},\"Forms\":\"$3d:props:messages:Forms\",\"HomeClient\":{\"Cale